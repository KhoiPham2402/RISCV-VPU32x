module control_unit (
	input  logic  [8:0]	instr,      // sliced instruction bits (e.g. {funct3, opcode[4:0]})
	input  logic			br_less,
	input  logic			br_equal,
	
	output logic			pc_sel,
	output logic  [2:0]	Immsel,
	output logic  [3:0]	alu_op,
	output logic  [1:0]	wb_sel,
	output logic			br_un,
	output logic  [1:0]	opa_sel,
	output logic			opb_sel,
	output logic			mem_wren,
	output logic			rd_wren,
	output logic			insn_vld,
	output logic			func7
);

	// local slices
	logic [4:0] opcode;
	logic [2:0] func3;
	// optional: bit30 if you want sub/sra detection: logic funct7_30 = instr_xxx;

	assign opcode = instr[4:0];   // keep same slicing as bạn đã dùng
	assign func3  = instr[7:5];
	assign func7  = instr[8];

	// opcodes (5-bit as you're using)
	localparam R_TYPE    = 5'b01100;
	localparam I_TYPE    = 5'b00100; // ALU immediate (ADDI, ORI, ...)
	localparam S_TYPE    = 5'b01000; // stores
	localparam B_TYPE    = 5'b11000; // branches
	localparam LOAD_TYPE = 5'b00000; // loads
	localparam LUI       = 5'b01101;
	localparam AUIPC     = 5'b00101;
	localparam JALR      = 5'b11001;
	localparam JAL       = 5'b11011;

	always_comb begin
		// default signals (safe defaults)
		pc_sel   = 1'b0;
		Immsel   = 3'b000;
		alu_op   = 4'b0000;
		wb_sel   = 2'b00;
		br_un    = 1'b0;
		opa_sel  = 2'b00;
		opb_sel  = 1'b0;
		mem_wren = 1'b0;
		rd_wren  = 1'b0;
		insn_vld = 1'b0;

		case (opcode)
			R_TYPE: begin
				// Register-register arithmetic
				insn_vld = 1'b1;
				pc_sel   = 1'b0;    // next PC = pc+4 normally
				rd_wren  = 1'b1;    // writeback to rd
				opa_sel  = 2'b00;    // A = rs1
				opb_sel  = 1'b0;    // B = rs2
				mem_wren = 1'b0;    // no memory write
				wb_sel   = 2'b01;   // write back ALU result
				// ALU op mapping (example encoding)
				// 0000: ADD, 0001: SLL, 0010: SLT, 0011: SLTU, 0100: XOR
				// 0101: SRL/SRA, 0110: OR, 0111: AND
				case (func3) 
					3'b000: alu_op = {instr[8],3'b000}; // ADD / SUB (distinguish SUB via extra bit if needed)
					3'b001: alu_op = {instr[8],3'b001}; // SLL
					3'b010: alu_op = {instr[8],3'b010}; // SLT (signed)
					3'b011: alu_op = {instr[8],3'b011}; // SLTU (unsigned)
					3'b100: alu_op = {instr[8],3'b100}; // XOR
					3'b101: alu_op = {instr[8],3'b101}; // SRL / SRA (distinguish via funct7 bit if available)
					3'b110: alu_op = {instr[8],3'b110}; // OR
					3'b111: alu_op = {instr[8],3'b111}; // AND
					default: alu_op = 4'b0000;
				endcase
			end

			I_TYPE: begin
				// ALU immediate (ADDI, ORI, etc.)
				insn_vld = 1'b1;
				pc_sel   = 1'b0;
				rd_wren  = 1'b1;
				opa_sel  = 2'b00;    // A = rs1
				opb_sel  = 1'b1;    // B = immediate
				mem_wren = 1'b0;
				wb_sel   = 2'b01;   // ALU -> rd	
				// Immediate selection: (example)
				Immsel = 3'b000; // choose I-type imm (caller can reassign encoding as needed)

				case (func3)
					3'b000: alu_op = 4'b0000; // ADDI
					3'b010: alu_op = 4'b0010; // SLTI
					3'b011: alu_op = 4'b0011; // SLTIU
					3'b100: alu_op = 4'b0100; // XORI
					3'b110: alu_op = 4'b0110; // ORI
					3'b111: alu_op = 4'b0111; // ANDI
					3'b001: alu_op = 4'b0001; // SLLI
					3'b101: alu_op = 4'b0101; // SRLI / SRAI (distinguish via funct7)
					default: alu_op = 4'b0000;
				endcase
			end

			LOAD_TYPE: begin
				// Loads
				insn_vld = 1'b1;
				pc_sel   = 1'b0;
				rd_wren  = 1'b1;      // load -> write to rd
				opa_sel  = 2'b00;      // A = rs1 (base)
				opb_sel  = 1'b1;      // B = imm (offset)
				mem_wren = 1'b0;
				wb_sel   = 2'b00;     // choose data from memory (wb_sel encoding: 01 = mem)
				Immsel   = 3'b000;    // I-type imm for load
				alu_op   = 4'b0000;   // use ADD to form address
			end

			S_TYPE: begin
				// Stores
				insn_vld = 1'b1;
				pc_sel   = 1'b0;
				rd_wren  = 1'b0;
				opa_sel  = 2'b00;    // base
				opb_sel  = 1'b1;    // imm offset
				mem_wren = 1'b1;    // enable memory write
				wb_sel   = 2'b00;   // don't care
				Immsel   = 3'b001;  // S-type immediate 
				alu_op   = 4'b0000; // ADD to compute address
			end

			B_TYPE: begin
				// Branches
				insn_vld = 1'b1;
				// default: next PC = pc+4
				wb_sel   = 2'b00;   // don't care
				pc_sel   = 1'b0;
				rd_wren  = 1'b0;
				opa_sel  = 2'b01;
				opb_sel  = 1'b1;
				mem_wren = 1'b0;
				Immsel   = 3'b010; // B-type immediate encoding

				// decide branch selection: if branch true then pc_sel = 1 (use branch target)
				case (func3)
					3'b000: begin // BEQ
						br_un = 1'b0; // signed vs unsigned doesn't matter for equality
						if (br_equal) pc_sel = 1'b1;
					end
					3'b001: begin // BNE
						br_un = 1'b0;
						if (!br_equal) pc_sel = 1'b1;
					end
					3'b100: begin // BLT (signed)
						br_un = 1'b1;
						if (br_less) pc_sel = 1'b1;
					end
					3'b101: begin // BGE (signed)
						br_un = 1'b1;
						if (!br_less) pc_sel = 1'b1;
					end
					3'b110: begin // BLTU (unsigned)
						br_un = 1'b0;
						if (br_less) pc_sel = 1'b1;
					end
					3'b111: begin // BGEU
						br_un = 1'b0;
						if (!br_less) pc_sel = 1'b1;
					end
					default: pc_sel = 1'b0;
				endcase
			end

			JAL: begin
				// Jump and Link (pc <- target, rd = pc+4)
				insn_vld = 1'b1;
				pc_sel   = 1'b1;    // use jump target
				rd_wren  = 1'b1;
				wb_sel   = 2'b10;   // example: wb_sel = 10 means write pc+4
				opa_sel  = 2'b01;
				opb_sel  = 1'b1;
				mem_wren = 1'b0;
				Immsel   = 3'b100;  // J-type imm
				alu_op   = 4'b0000; // ADD to compute address
			end

			JALR: begin
				insn_vld = 1'b1;
				pc_sel   = 1'b1;    	// use computed target (rs1 + imm)
				rd_wren  = 1'b1;	// write pc+4 to rd
				wb_sel   = 2'b10;   	// write pc+4
				opa_sel  = 2'b00;  	//rs1
				opb_sel  = 1'b1;	//immediate Itype
				mem_wren = 1'b0;
				Immsel   = 3'b000;  // I-type imm
				alu_op   = 4'b0000; // ADD to compute address
			end

			LUI: begin
				insn_vld = 1'b1;
				pc_sel   = 1'b0;
				rd_wren  = 1'b1;
				opa_sel  = 2'b10;    // choose imm directly (implementation dependent)
				opb_sel  = 1'b0;
				mem_wren = 1'b0;
				wb_sel   = 2'b11;   // immgen -> rd
				Immsel   = 3'b011;  // U-type imm
				alu_op   = 4'b0000; // pass-through
			end

			AUIPC: begin
				insn_vld = 1'b1;
				pc_sel   = 1'b0;
				rd_wren  = 1'b1;
				opa_sel  = 2'b01;    // pc
				opb_sel  = 1'b1;    // imm
				wb_sel   = 2'b01;
				Immsel   = 3'b011;  // U-type for AUIPC
				alu_op   = 4'b0000; // add pc + imm
			end

			default: begin
				// unknown opcode -> mark invalid
				insn_vld = 1'b0;
				pc_sel   = 1'b0;
				rd_wren  = 1'b0;
				mem_wren = 1'b0;
			end
		endcase
	end

endmodule
